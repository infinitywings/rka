{
  "contract": "rka-legacy-writer-export/v1",
  "format_version": 1,
  "schema_fingerprint": "9008c196a5da9bc4151f44c9eea9332f994041d2691a2fcb5f3ceb5cf52059ff",
  "purpose": "Lossless handoff of frozen Core-owned legacy Writer state into standalone Writer staging.",
  "authority": "Import is staging-only and does not switch Writer authority.",
  "nullable_project_id_tables": [
    "manuscript_migration_issues"
  ],
  "digest_contract": {
    "canonical_json": "UTF-8 JSON with ensure_ascii=false, sort_keys=true, separators=[',',':']",
    "schema_fingerprint": "sha256(canonical_json({table: table.schema_sha256}))",
    "tables_sha256": "sha256(canonical_json({table: {row_count,sha256,primary_key_sha256,schema_sha256}}))",
    "core_references_sha256": "sha256(canonical_json(core_references))",
    "semantic_root_sha256": "sha256(canonical_json({contract,project_id,schema_fingerprint,tables_sha256,core_references_sha256}))"
  },
  "required_manifest_fields": [
    "contract",
    "format_version",
    "schema_fingerprint",
    "source",
    "authority",
    "required_tables",
    "tables",
    "table_count",
    "row_count",
    "tables_sha256",
    "core_references",
    "core_references_sha256",
    "semantic_root_sha256"
  ],
  "required_table_descriptor_fields": [
    "path",
    "row_count",
    "sha256",
    "primary_key_sha256",
    "schema_sha256",
    "primary_key",
    "columns",
    "foreign_keys"
  ],
  "required_core_reference_fields": [
    "source_table",
    "source_primary_key",
    "source_field",
    "entity_type",
    "entity_id",
    "target_table",
    "source_version",
    "stored_content_hash",
    "snapshot_fingerprint",
    "snapshot_metadata",
    "resolution_status"
  ],
  "tables": [
    "manuscript_checkpoints",
    "manuscript_claim_evidence",
    "manuscript_claim_ratifications",
    "manuscript_claim_units",
    "manuscript_claim_verification_attestations",
    "manuscript_claim_versions",
    "manuscript_claims",
    "manuscript_evaluation_events",
    "manuscript_migration_issues",
    "manuscript_planning_artifact_versions",
    "manuscript_planning_artifacts",
    "manuscript_planning_branch_events",
    "manuscript_planning_branches",
    "manuscript_planning_evidence_bindings",
    "manuscript_planning_promotion_events",
    "manuscript_reference_members",
    "manuscript_source_events",
    "manuscript_source_proposals",
    "manuscript_unit_citations",
    "manuscript_unit_evidence",
    "manuscript_unit_outline_profiles",
    "manuscript_units",
    "manuscripts",
    "reference_validation_attestations",
    "reference_validation_migration_issues",
    "semantic_patch_context_manifests",
    "semantic_patch_proposal_events",
    "semantic_patch_proposals",
    "semantic_patch_provider_events"
  ]
}
